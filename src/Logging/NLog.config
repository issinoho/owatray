<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- 
  See http://nlog-project.org/wiki/Configuration_file 
  for information on customizing logging rules and outputs.
   -->
  <targets async="false">
    <!-- ${basedir} (AppDomain.CurrentDomain.BaseDirectory) always ends in a trailing separator already,
         so these paths don't start with an extra "/" - doing so used to double up the slash right
         after the base directory once LoggerProxy normalizes "/" to "\" for display. -->
    <target name="allTarget" xsi:type="File" deleteOldFileOnStartup="false" archiveEvery="Day" maxArchiveFiles="7"
            fileName="${basedir}logs/log-file.txt"
            layout="[${date:format=dd/MM/yyyy HH\:mm\:ss}] (${uppercase:${level:padding=5}}) - ${message} ${onexception:EXCEPTION OCCURRED\:${exception:format=type,message,method:maxInnerExceptionLevel=5:innerFormat=shortType,message,method}}"
            autoFlush="true" />
    <target name="log4j" xsi:type="File" deleteOldFileOnStartup="false" archiveEvery="Day" maxArchiveFiles="7"
            fileName="${basedir}logs/log-file.xml"
            layout="${log4jxmlevent:includeNLogData=false}"
            autoFlush="true" />
  </targets>

  <rules>
    <!-- Debug carries deep diagnostic detail (poll cycles, item counts, shell/auto-login flow, etc.)
         that's intentionally never shown in the on-screen connection log - see LoggerProxy.Debug. -->
    <logger name="*" minlevel="Debug" writeTo="allTarget,log4j" />
  </rules>
</nlog>